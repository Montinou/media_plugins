# Session credentials — NEVER commit these
*.cookies.json
*cookies*.json
.flow-token.json
*.token.json
.secrets/
.env
.env.*

# Custom packs — account-specific ids (appletId, projectId), never in the
# public repo. Keep yours in ~/.config/<plugin>/packs/ and point FLOW_PACK at
# it, or version it in a private fork. Only the template ships here.
*/packs/*
!*/packs/README.md
!*/packs/_template/
!*/packs/_template/**

# Generation outputs — anclados a la raíz: sin la barra inicial, la regla
# `flow-applets/` también se comía google-flow/skills/flow-applets/, que es
# una skill y sí se versiona.
/flow-out/
/flow-applets/
/work/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
